# Backend
DATABASE_URL=sqlite:///./propchain.db
SECRET_KEY=change-me-in-production
STORAGE_PATH=./storage
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_MOCK_MODE=true

# Engine selection (Phase 2). The code defaults are "fake" so a fresh checkout
# boots without Tesseract/OpenCV; uncomment these to run the real engines.
# Known names: OCR_ENGINE=fake|tesseract  DOC_CLASSIFIER_ENGINE=fake|keyword
#              NLP_EXTRACTOR_ENGINE=fake|patterns
# Cross-validator / ownership builder / rule engine are still Phase-1 fakes.
# OCR_ENGINE=tesseract
# DOC_CLASSIFIER_ENGINE=keyword
# NLP_EXTRACTOR_ENGINE=patterns

# OCR (Phase 2) - Tesseract binary + tessdata from the local micromamba env
TESSERACT_CMD=C:\Users\visha\tools\tessenv\Library\bin\tesseract.exe
TESSDATA_PREFIX=C:\Users\visha\tools\tessenv\share\tessdata

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
