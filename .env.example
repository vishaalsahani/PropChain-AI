# PropChain-AI environment template
#
# Backend: copy this file to backend/.env (the launcher runs the backend from
# backend/, so that is the file pydantic-settings reads).
#
# Frontend: the API URL defaults to http://localhost:8000. To override it,
# create frontend/.env.local and set NEXT_PUBLIC_API_URL there.

# --- Backend -----------------------------------------------------------------
DATABASE_URL=sqlite:///./propchain.db
SECRET_KEY=change-me-in-production
STORAGE_PATH=./storage
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_MOCK_MODE=true

# --- Phase 5: real EVM anchoring (optional) ---------------------------------
# With MOCK_MODE=true the API creates a synthetic tx and labels it "mock".
# For a real local anchor:
#   1. cd contracts && npm install && npx hardhat node          (terminal 1)
#   2. cd contracts && npm run deploy:local                     (terminal 2)
#   3. copy the address + Hardhat account #0 key into backend/.env, then restart
#      the backend and set BLOCKCHAIN_MOCK_MODE=false.
# Never use a Hardhat development key on a public network.
# BLOCKCHAIN_MOCK_MODE=false
# BLOCKCHAIN_NETWORK=hardhat
# BLOCKCHAIN_CHAIN_ID=31337
# BLOCKCHAIN_CONTRACT_ADDRESS=0x...
# BLOCKCHAIN_PRIVATE_KEY=0x...
# BLOCKCHAIN_TX_TIMEOUT=120
# BLOCKCHAIN_GAS_LIMIT=500000

# --- Engine selection (Phases 2-3) ------------------------------------------
# The code defaults are "fake" so a fresh checkout boots without Tesseract or
# OpenCV. Uncomment these to run the real engines.
# Known names:
#   OCR_ENGINE=fake|tesseract
#   DOC_CLASSIFIER_ENGINE=fake|keyword
#   NLP_EXTRACTOR_ENGINE=fake|patterns
#   CROSS_VALIDATOR_ENGINE=fake|matrix
#   OWNERSHIP_BUILDER_ENGINE=fake|evidence
#   RULE_ENGINE=fake|mh_pack
# OCR_ENGINE=tesseract
# DOC_CLASSIFIER_ENGINE=keyword
# NLP_EXTRACTOR_ENGINE=patterns
# CROSS_VALIDATOR_ENGINE=matrix
# OWNERSHIP_BUILDER_ENGINE=evidence
# RULE_ENGINE=mh_pack

# --- OCR (optional; scanned images only) ------------------------------------
# Tesseract is a system binary, not a pip package. Leave these unset when the
# binary and tessdata directory are already on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata
# OCR_DPI=300
# OCR_LANGS=eng+mar

# --- Frontend (frontend/.env.local) -----------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000
